 u_utool_nl.c              | 97 ++++++++++++++++++++++++++++++++-------
 u_utool_pkt.c             | 18 ++++++++
 u_utool_pkt.h             |  1 +
 7 files changed, 120 insertions(+), 20 deletions(-)

diff --git a/doc/ubctl.pod b/doc/ubctl.pod
index 818d237..cc3178d 100644
--- a/doc/ubctl.pod
+++ b/doc/ubctl.pod
@@ -91,7 +91,7 @@ $function: function name, optional parameters, different processing functions ar
 
     ta: pkt_stats, abn_stats
 
-    nl: pkt_stats, abn_stats, ssu_stats, ssu_sw, ssu_oq, ssu_p2p
+    nl: pkt_stats, abn_stats, ssu_stats, ssu_sw, ssu_oq, ssu_p2p, ssu_vl_pkt
 
     tp: pkt_stats, abn_stats, scc_version, scc_log, scc_debug_en, rx_bank, route_result
 
@@ -198,6 +198,8 @@ B<Query NL Layer Information>:
  ubctl -c ${chip_id} -d ${ub_ctl_id} -m nl -p ${port_id} -f ssu_sw
  ubctl -c ${chip_id} -d ${ub_ctl_id} -m nl -p ${port_id} -f ssu_oq
  ubctl -c ${chip_id} -d ${ub_ctl_id} -m nl -p ${port_id} -f ssu_p2p
+ ubctl -c ${chip_id} -d ${ub_ctl_id} -m nl -p ${port_id} -f ssu_vl_pkt
+ ubctl -c ${chip_id} -d ${ub_ctl_id} -m nl -p ${port_id} -f ssu_vl_pkt -e ${value}
 
 B<Query UB internal MSG queue information and entry details>:
  
